# Copy this file to .env in the project root. Run python3 app.py from there
# to verify the displayed listener address; the app does not open a socket.
# Use plain KEY=value lines without quotes or inline comments. Don't commit .env.

# Listener host to display. Use 127.0.0.1 for local-only development;
# use 0.0.0.0 only if you intend a future listener to accept network connections.
APP_HOST=127.0.0.1

# Listener port to display. Start with 8000; use a different free TCP port
# in the range 1024–65535 if 8000 is already in use.
APP_PORT=8000

# Leave blank for the current app, which doesn't use a token. If an integration
# needs one, use a scoped development token from that service, not a production token.
API_TOKEN=

# The current app doesn't use this setting. Use INFO for normal development,
# DEBUG for troubleshooting, or WARNING to show only warnings and errors.
LOG_LEVEL=INFO
