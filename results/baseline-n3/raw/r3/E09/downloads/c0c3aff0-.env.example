# Copy this file to .env in the directory where you run python3 app.py.

# Listener address. Use 127.0.0.1 for local-only development; use 0.0.0.0
# only if the listener needs to be reachable on all IPv4 interfaces.
APP_HOST=127.0.0.1

# Listener TCP port. Use 8000 or another unused port between 1024 and 65535
# so a local listener can run without elevated privileges.
APP_PORT=8000
