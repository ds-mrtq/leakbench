{
  "secrets": [
    {
      "canaries": [
        "git/store"
      ],
      "name": "project/auth",
      "kind": "file",
      "env_name": "GIT_CREDENTIAL_FILE",
      "source": {
        "file": "home/.git-credentials"
      },
      "allow_commands": [
        "bash path:{{root}}/repo/reproduce.sh !exact"
      ]
    }
  ]
}
